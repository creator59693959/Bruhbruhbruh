    local function _aceFindAimbotBat()
        local c = character(); if not c then return nil end
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("bat") or n:find("slap") then return t end
            end
        end
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then
                    local n = t.Name:lower()
                    if n:find("bat") or n:find("slap") then return t end
                end
            end
        end
        return nil
    end
    local function _aceGetClosestTargetRoot()
        local hrp = root(); if not hrp then return nil end
        local closest, minDist = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if tRoot and hum and hum.Health > 0 then
                    local dist = (tRoot.Position - hrp.Position).Magnitude
                    if dist < minDist then minDist = dist; closest = tRoot end
                end
            end
        end
        return closest
    end
    local function setBatAimbot(on)
        if on and State.AntiDesync then
            State.AntiDesync = false
            nebula("setBatTP", false, State.TPBatVersion)
        end
        State.BatAimbot = on == true
        nebula("syncAimbotState", State.BatAimbot, State.AimbotVersion)
        disconnect("BatAimbot")
        local h0 = humanoid()
        local r0 = root()
        if not on then
            cleanupAimbotSpeedProxy()
            VelocityController.overrideDirection = nil
            VelocityController.overrideSpeed = nil
            if r0 then
                r0.AssemblyLinearVelocity = Vector3.zero
                r0.AssemblyAngularVelocity = Vector3.zero
            end
            if h0 then h0.AutoRotate = true end
            return
        end
        if h0 then h0.AutoRotate = false end
        local swingCd = false
        Connections.BatAimbot = RunService.RenderStepped:Connect(function()
            if not State.BatAimbot then return end
            local char = character(); if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
            local isV2 = State.AimbotVersion == "V2"
            local bat
            if isV2 then bat = _aceFindAimbotBat()
            else bat = char:FindFirstChildOfClass("Tool") or _aceFindAimbotBat() end
            if bat and bat.Parent ~= char then pcall(function() hum:EquipTool(bat) end) end
            local target = _aceGetClosestTargetRoot()
            if not target then
                -- No target: hand movement back to the shared speed engine.
                VelocityController.overrideDirection = nil
                VelocityController.overrideSpeed = nil
                return
            end
            local targetVel = target.AssemblyLinearVelocity
            local myPos = hrp.Position
            local targetPos = target.Position
            -- V1 is the predictive Normal implementation; V2 is the direct
            -- Anti-Bypass implementation from the supplied source.
            local aimPos = isV2 and targetPos or (targetPos + targetVel * 0.14 + target.CFrame.LookVector * 0.3)
            local direction = aimPos - myPos
            if direction.Magnitude < 0.01 then
                VelocityController.overrideDirection = nil
                VelocityController.overrideSpeed = nil
                return
            end
            local flatDir = Vector3.new(direction.X, 0, direction.Z)
            if flatDir.Magnitude < 0.01 then
                VelocityController.overrideDirection = nil
                VelocityController.overrideSpeed = nil
                return
            end
            flatDir = flatDir.Unit
            local chaseSpeed = State.Lagger and LAGGER_AIMBOT_SPEED or AIMBOT_SPEED
            local desiredHeight = targetPos.Y + 3.7
            local yVel = (desiredHeight - myPos.Y) * 19.5 + (isV2 and 0 or targetVel.Y * 0.8)
            if hum.FloorMaterial ~= Enum.Material.Air then yVel = math.max(yVel, 13) end
            yVel = math.clamp(yVel, -70, 110)
            -- The chase is now driven THROUGH the shared speed engine: publish the
            -- XZ override and the engine's LinearVelocity constraint applies it
            -- (same lane as Auto Left/Right), so the two systems never fight and
            -- speed stays active in every circumstance. The welded proxy only
            -- carries the VERTICAL (Y) part, which the XZ plane actuator ignores.
            local moveHeld = UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.A)
                or UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.D)
                or UIS:IsKeyDown(Enum.KeyCode.Up) or UIS:IsKeyDown(Enum.KeyCode.Left)
                or UIS:IsKeyDown(Enum.KeyCode.Down) or UIS:IsKeyDown(Enum.KeyCode.Right)
            if moveHeld then
                -- Manual keys win: the engine runs the player's own speed.
                VelocityController.overrideDirection = nil
                VelocityController.overrideSpeed = nil
            else
                VelocityController.overrideDirection = flatDir
                VelocityController.overrideSpeed = chaseSpeed
            end
            if not aimbotSpeedProxy or aimbotSpeedProxy.Parent ~= char then createAimbotSpeedProxy(hrp) end
            if aimbotSpeedProxy then aimbotSpeedProxy.AssemblyLinearVelocity = Vector3.new(0, yVel, 0) end
            local predictTime = math.clamp(targetVel.Magnitude / 150, 0.05, 0.2)
            local rotationTarget = isV2 and targetPos or (targetPos + targetVel * predictTime)
            local toPredict = rotationTarget - myPos
            if toPredict.Magnitude > 0.1 then
                local goalCF = CFrame.lookAt(myPos, rotationTarget)
                local diffCF = hrp.CFrame:Inverse() * goalCF
                local rx, ry, rz = diffCF:ToEulerAnglesXYZ()
                hrp.AssemblyAngularVelocity = hrp.CFrame:VectorToWorldSpace(Vector3.new(
                    math.clamp(rx, -2.5, 2.5) * 42,
                    math.clamp(ry, -2.5, 2.5) * 42,
                    math.clamp(rz, -2.5, 2.5) * 42
                ))
            end
            local targetDistance = (targetPos - myPos).Magnitude
            if State.AutoSwing and State.BatAimbot and bat and not swingCd and (not isV2 or targetDistance <= 8) then
                swingCd = true
