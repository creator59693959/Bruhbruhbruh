                    if object:IsA("ScrollingFrame") then object.ScrollBarImageColor3 = ThemeSystem.mapColor(object.ScrollBarImageColor3) end
                    if object:IsA("UIStroke") then object.Color = ThemeSystem.mapColor(object.Color) end
                    if object:IsA("UIGradient") then object.Color = ThemeSystem.mapSequence(object.Color) end
                end)
