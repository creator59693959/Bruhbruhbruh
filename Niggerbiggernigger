    RunService.RenderStepped:Connect(function(dt)
        if not bladenightvsRefs.speedLabel or not bladenightvsRefs.speedLabel.Parent then return end
        local hrp = root()
        if not hrp then measuredRoot, displayedMoveSpeed, speedSampleElapsed = nil, 0, 0; return end
        if measuredRoot ~= hrp or dt <= 0 then
            measuredRoot, displayedMoveSpeed, speedSampleElapsed = hrp, 0, 0
        else
            -- Sample the post-physics velocity instead of frame-to-frame positions;
            -- network corrections and tiny CFrame shifts otherwise create huge spikes.
            speedSampleElapsed += dt
            if speedSampleElapsed >= SPEED_SAMPLE_WINDOW then
                local velocity = hrp.AssemblyLinearVelocity
                local realSpeed = VelocityController.isDriving and VelocityController.lastActualSpeed
                    or Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                realSpeed = tonumber(realSpeed) or 0
                if realSpeed < .45 then realSpeed = 0 end
                if VelocityController.isDriving then
                    displayedMoveSpeed = math.max(0, tonumber(VelocityController.appliedSpeed) or realSpeed)
                elseif math.abs(realSpeed - displayedMoveSpeed) >= .25 then
                    displayedMoveSpeed += (realSpeed - displayedMoveSpeed) * .8
                end
                if displayedMoveSpeed < .25 then displayedMoveSpeed = 0 end
                speedSampleElapsed = 0
            end
        end
        bladenightvsRefs.speedLabel.Text = string.format("%.1f SPEED", displayedMoveSpeed)
    end)

