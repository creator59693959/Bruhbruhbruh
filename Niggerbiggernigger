    function setupPlayerHighlight(targetPlayer)
        if targetPlayer == LP then return end
        if targetPlayer.Character then task.spawn(attachPlayerHighlight, targetPlayer, targetPlayer.Character) end
        table.insert(espConnections, targetPlayer.CharacterAdded:Connect(function(character)
            if espEnabled then task.spawn(attachPlayerHighlight, targetPlayer, character) end
        end))
    end

    _GACC.startESP = function()
        _GACC.playerHighlightEnabled = true
        State.ESP = true
        if espEnabled then
            pcall(ensureEspBoxGui)
            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                pcall(setupPlayerHighlight, targetPlayer)
                if targetPlayer.Character and attachPlayerHighlight then
                    pcall(attachPlayerHighlight, targetPlayer, targetPlayer.Character)
                end
            end
            return
        end
        espEnabled = true
        ensureEspBoxGui()
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            setupPlayerHighlight(targetPlayer)
        end
        table.insert(espConnections, Players.PlayerAdded:Connect(function(targetPlayer)
            if espEnabled then setupPlayerHighlight(targetPlayer) end
        end))
        table.insert(espConnections, Players.PlayerRemoving:Connect(removePlayerHighlight))
        table.insert(espConnections, RunService.RenderStepped:Connect(function()
            if not espEnabled then return end
            local camera = workspace.CurrentCamera
            local localCharacter = LP.Character
            local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
            if not camera then
                for _, obj in pairs(espObjects) do
                    if obj.screenLine then obj.screenLine.Visible = false end
                    if obj.box then obj.box.Visible = false end
                end
                return
            end
            local fromPosition, fromVisible
            if localRoot then
                fromPosition, fromVisible = camera:WorldToViewportPoint(localRoot.Position)
            else
                fromPosition, fromVisible = Vector3.zero, false
            end
            local accent = ACC()
            for targetPlayer, obj in pairs(espObjects) do
                local targetCharacter = targetPlayer.Character
                local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                local targetHum = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
                local alive = targetCharacter and targetRoot and targetHum and targetHum.Health > 0

                if obj.highlight then
                    obj.highlight.FillColor = accent
                    obj.highlight.OutlineColor = accent:Lerp(Color3.fromRGB(255, 255, 255), .55)
                end

                local screenLine = obj.screenLine
                if screenLine and targetRoot and localRoot then
                    local toPosition, toVisible = camera:WorldToViewportPoint(targetRoot.Position)
                    local visible = fromVisible and toVisible and fromPosition.Z > 0 and toPosition.Z > 0
                    screenLine.Visible = visible
                    if visible then
                        screenLine.From = Vector2.new(fromPosition.X, fromPosition.Y)
                        screenLine.To = Vector2.new(toPosition.X, toPosition.Y)
                        screenLine.Color = accent
                    end
                elseif screenLine then
                    screenLine.Visible = false
                end

                -- VX7 2D box (tighter proportions)
                local box = obj.box
                if box and alive then
                    local head = targetCharacter:FindFirstChild("Head")
                    local top = (head and head.Position or targetRoot.Position + Vector3.new(0, 1.5, 0)) + Vector3.new(0, 1.15, 0)
                    local bottom = targetRoot.Position - Vector3.new(0, 2.7, 0)
                    local topV, topOn = camera:WorldToViewportPoint(top)
                    local botV, botOn = camera:WorldToViewportPoint(bottom)
                    if topOn and botOn and topV.Z > 0 and botV.Z > 0 then
                        local h = math.abs(botV.Y - topV.Y)
                        local w = h * 0.48
                        if h > 2 then
                            box.Size = UDim2.fromOffset(w, h)
                            box.Position = UDim2.fromOffset((topV.X + botV.X) * 0.5 - w * 0.5, math.min(topV.Y, botV.Y))
                            box.BackgroundColor3 = accent
                            local stroke = box:FindFirstChildOfClass("UIStroke")
                            if stroke then stroke.Color = accent end
                            box.Visible = true
                        else
                            box.Visible = false
                        end
                    else
                        box.Visible = false
                    end
                elseif box then
                    box.Visible = false
                end
            end
        end))
