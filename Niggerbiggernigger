    local function performInstaReset()
        if _instaResetDebounce then return end
        local characterModel = character()
        local humanoidObject = characterModel and characterModel:FindFirstChildOfClass("Humanoid")
        if not characterModel or not humanoidObject or humanoidObject.Health <= 0 then return end
        _instaResetDebounce = true
        local camera = workspace.CurrentCamera
        local savedCamera = camera and {
            CFrame = camera.CFrame,
            CameraType = camera.CameraType,
            CameraSubject = camera.CameraSubject,
        } or nil

        if camera then
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CFrame = savedCamera.CFrame
        end

        if _instaResetCharacterConnection then
            _instaResetCharacterConnection:Disconnect()
        end
        _instaResetCharacterConnection = LP.CharacterAdded:Connect(function(newCharacter)
            task.wait(0.1)
            local newCamera = workspace.CurrentCamera
            local newHumanoid = newCharacter:FindFirstChildOfClass("Humanoid")
            if newCamera then
                newCamera.CameraType = savedCamera and savedCamera.CameraType or Enum.CameraType.Custom
                newCamera.CameraSubject = newHumanoid or (savedCamera and savedCamera.CameraSubject)
            end
            if _instaResetCharacterConnection then
                _instaResetCharacterConnection:Disconnect()
                _instaResetCharacterConnection = nil
            end
        end)

        task.spawn(function()
            local originalHipHeight = humanoidObject.HipHeight
            local originalCanCollide = {}
            local attempts = 0
            local done = false

            for _, part in ipairs(characterModel:GetChildren()) do
                if part:IsA("BasePart") then originalCanCollide[part] = part.CanCollide end
            end

            while characterModel.Parent and humanoidObject.Health > 0
                and LP.Character == characterModel and attempts < 40 do
                pcall(function()
                    humanoidObject.HipHeight = 1e30
                    humanoidObject.AutoRotate = true
                    for _, part in ipairs(characterModel:GetChildren()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end)

                if not characterModel.Parent or humanoidObject.Health <= 0 or LP.Character ~= characterModel then
                    done = true
                    break
                end

                attempts += 1
                task.wait(0.05)
            end

            if not done and characterModel.Parent and humanoidObject.Health > 0 then
                pcall(function() humanoidObject.Health = 0 end)
                task.wait(0.1)
                if not characterModel.Parent or humanoidObject.Health <= 0 then done = true end
            end

            if not done and characterModel.Parent and humanoidObject.Health > 0 then
                if humanoidObject.Parent then
                    pcall(function()
                        humanoidObject.HipHeight = originalHipHeight
                        for _, part in ipairs(characterModel:GetChildren()) do
                            if part:IsA("BasePart") and originalCanCollide[part] ~= nil then
                                part.CanCollide = originalCanCollide[part]
                            end
                        end
                    end)
                end
                if camera and savedCamera then
                    camera.CameraType = savedCamera.CameraType
                    camera.CameraSubject = savedCamera.CameraSubject
                    camera.CFrame = savedCamera.CFrame
                end
                if _instaResetCharacterConnection then
                    _instaResetCharacterConnection:Disconnect()
                    _instaResetCharacterConnection = nil
                end
            end
        end)

        task.delay(0.35, function() _instaResetDebounce = false end)
    end

