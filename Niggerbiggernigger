    local function reorderSections(page, orderedNames)
        local children = {}
        for _, child in ipairs(page:GetChildren()) do
            if child:IsA("GuiObject") then table.insert(children, child) end
        end
        table.sort(children, function(left, right)
            return (left.LayoutOrder or 0) < (right.LayoutOrder or 0)
        end)
        local groups, current = {}, nil
        for _, child in ipairs(children) do
            local title = child:GetAttribute("SectionTitle")
            if title then
                current = {header = child, children = {}}
                groups[title] = current
            elseif current then
                table.insert(current.children, child)
            end
        end
        local nextOrder = 0
        local function applyGroup(group)
            if not group then return end
            nextOrder += 1
            group.header.LayoutOrder = nextOrder
            for _, child in ipairs(group.children) do
                if child:IsA("GuiObject") then
                    nextOrder += 1
                    child.LayoutOrder = nextOrder
                end
            end
        end
        for _, name in ipairs(orderedNames) do applyGroup(groups[name]) end
        for _, child in ipairs(children) do
            local title = child:GetAttribute("SectionTitle")
            if title and not table.find(orderedNames, title) then applyGroup(groups[title]) end
        end
    end

