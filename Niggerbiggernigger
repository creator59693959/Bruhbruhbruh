    ThemeSystem.watch = function(object)
        if ThemeSystem.isBackgroundObject(object) or ThemeSystem.watched[object] then return end
        local saved = {}
        ThemeSystem.originals[object] = saved
        ThemeSystem.watched[object] = true
        local properties = {}
        if object:IsA("GuiObject") then table.insert(properties,"BackgroundColor3") end
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            table.insert(properties,"TextColor3")
            table.insert(properties,"TextStrokeColor3")
        end
        if object:IsA("ImageLabel") or object:IsA("ImageButton") then table.insert(properties,"ImageColor3") end
        if object:IsA("ScrollingFrame") then table.insert(properties,"ScrollBarImageColor3") end
        if object:IsA("UIStroke") then table.insert(properties,"Color") end
        if object:IsA("UIGradient") then table.insert(properties,"ColorSequence") end
        for _, property in ipairs(properties) do
            local actualProperty = property == "ColorSequence" and "Color" or property
            saved[property] = object[actualProperty]
            object:GetPropertyChangedSignal(actualProperty):Connect(function()
                if ThemeSystem.locked or not object.Parent then return end
                local incoming = object[actualProperty]
                if ThemeSystem.current == "MONO" then
                    local sourceValue = saved[property] or incoming
                    if property ~= "ColorSequence" and typeof(incoming) == "Color3" then
                        local spread = math.max(incoming.R,incoming.G,incoming.B) - math.min(incoming.R,incoming.G,incoming.B)
                        if spread > .025 then
                            sourceValue = incoming
                            saved[property] = incoming
                        end
                    end
                    ThemeSystem.locked = true
                    object[actualProperty] = ThemeSystem.valueFor(property,sourceValue)
                    ThemeSystem.locked = false
                else
                    saved[property] = incoming
                end
            end)
        end
    end
    ThemeSystem.paint = function(object)
        local saved = ThemeSystem.originals[object]
        if not saved then return end
        for property, value in pairs(saved) do
            local actualProperty = property == "ColorSequence" and "Color" or property
            object[actualProperty] = ThemeSystem.valueFor(property,value)
        end
    end
