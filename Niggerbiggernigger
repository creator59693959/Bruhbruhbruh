    local XRayController = {originalTransparency = {}, connections = {}, loopId = 0}
    local function setXRay(enabled)
        local folders = {"Base", "PlotSign", "FriendPanel", "Cash", "Laser", "Decorations", "Skin", "Unlock", "Purchases"}
        local originalTransparency = XRayController.originalTransparency
        local connections = XRayController.connections
        for _, connection in ipairs(connections) do
            if typeof(connection) == "RBXScriptConnection" then connection:Disconnect() end
        end
        table.clear(connections)
        XRayController.loopId = XRayController.loopId + 1
        local loopId = XRayController.loopId
        State.XRay = enabled == true
        silentSaveFront()

        local function applyTransparency(instance, alphaPercent)
            if not instance or loopId ~= XRayController.loopId then return end
            local function apply(object)
                if object:IsA("BasePart") then
                    if originalTransparency[object] == nil then originalTransparency[object] = object.Transparency end
                    local original = originalTransparency[object]
                    if original < 1 then object.Transparency = original + (1 - original) * alphaPercent end
                elseif object:IsA("TextLabel") or object:IsA("TextButton") then
                    if originalTransparency[object] == nil then
                        originalTransparency[object] = {text = object.TextTransparency, bg = object.BackgroundTransparency}
                    end
                    local original = originalTransparency[object]
                    if original.text < 1 then object.TextTransparency = original.text + (1 - original.text) * alphaPercent end
                    if original.bg < 1 then object.BackgroundTransparency = original.bg + (1 - original.bg) * alphaPercent end
                elseif object:IsA("Frame") or object:IsA("ScrollingFrame") then
                    if originalTransparency[object] == nil then originalTransparency[object] = object.BackgroundTransparency end
                    local original = originalTransparency[object]
                    if original < 1 then object.BackgroundTransparency = original + (1 - original) * alphaPercent end
                elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
                    if originalTransparency[object] == nil then
                        originalTransparency[object] = {img = object.ImageTransparency, bg = object.BackgroundTransparency}
                    end
                    local original = originalTransparency[object]
                    if original.img < 1 then object.ImageTransparency = original.img + (1 - original.img) * alphaPercent end
                    if original.bg < 1 then object.BackgroundTransparency = original.bg + (1 - original.bg) * alphaPercent end
                end
            end

            apply(instance)
            for index, descendant in ipairs(instance:GetDescendants()) do
                apply(descendant)
                if index % 300 == 0 then
                    task.wait()
                    if loopId ~= XRayController.loopId then return end
                end
            end
        end

        local function trackSubtree(root, alphaPercent)
            if not root or loopId ~= XRayController.loopId then return end
            applyTransparency(root, alphaPercent)
            if loopId == XRayController.loopId then
                table.insert(connections, root.DescendantAdded:Connect(function(object)
                    applyTransparency(object, alphaPercent)
                end))
            end
        end

        local function processPlot(plot, alphaPercent)
            if not plot or loopId ~= XRayController.loopId then return end
            for _, name in ipairs(folders) do
                trackSubtree(plot:FindFirstChild(name), alphaPercent)
            end
            table.insert(connections, plot.ChildAdded:Connect(function(child)
                if loopId ~= XRayController.loopId then return end
                if table.find(folders, child.Name) then trackSubtree(child, alphaPercent) end
            end))
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if not podiums then return end
            local function processPodium(podium)
                for _, child in ipairs(podium:GetChildren()) do
                    if child.Name == "Claim" then
                        trackSubtree(child, alphaPercent)
                    elseif child.Name == "Base" then
                        trackSubtree(child:FindFirstChild("Decorations"), alphaPercent)
                    elseif child:IsA("Model") and child.Name ~= "Decorations" then
                        trackSubtree(child, alphaPercent)
                    end
                end
            end
            for _, podium in ipairs(podiums:GetChildren()) do processPodium(podium) end
            table.insert(connections, podiums.ChildAdded:Connect(function(podium)
                task.wait(0.1)
                if loopId == XRayController.loopId then processPodium(podium) end
            end))
        end

        if State.XRay then
            task.spawn(function()
                local plots
                repeat
                    if loopId ~= XRayController.loopId then return end
                    plots = workspace:FindFirstChild("Plots")
                    if not plots then task.wait(0.5) end
                until plots
                for _, plot in ipairs(plots:GetChildren()) do
                    if loopId ~= XRayController.loopId then return end
