        local Buttons = {}
        local unit = CONFIG.keySize + CONFIG.keyGap
        local widestRow = 0
        for _, row in ipairs(KEYBOARD_ROWS) do local total = 0 for _, def in ipairs(row) do total += (def.w or 1) end widestRow = math.max(widestRow, total) end
        local keysWidth = widestRow * unit - CONFIG.keyGap
        local keysHeight = #KEYBOARD_ROWS * unit - CONFIG.keyGap
        local bodySize = Vector2.new(keysWidth + CONFIG.mouseGap + CONFIG.mouseWidth, math.max(keysHeight, CONFIG.mouseHeight))
        local panel = Panel.create("KEYBOARD + MOUSE", bodySize, CONFIG.defaultPos)

        for rowIndex, row in ipairs(KEYBOARD_ROWS) do
            local x = 0
            local y = (rowIndex - 1) * unit
            for _, def in ipairs(row) do
                local width = (def.w or 1) * unit - CONFIG.keyGap
                local cell = makeKey(panel.body, def, {x = math.floor(x), y = y, w = math.floor(width), h = CONFIG.keySize})
                if def.id then Buttons[def.id] = cell end
                x += (def.w or 1) * unit
            end
        end

        local function buildMouse(parent, originX, originY, width, height)
            local radius=math.floor(width*.42); local topPart=math.floor(height*.40)
            local wheelW=math.max(7,math.floor(width*.16)); local sideW=math.floor((width-wheelW-4)/2)
            local body=new("Frame",{Name="Mouse",BackgroundColor3=THEME.keyFill,BackgroundTransparency=THEME.keyIdle,BorderSizePixel=0,ClipsDescendants=true,Position=UDim2.fromOffset(originX,originY),Size=UDim2.fromOffset(width,height),Parent=parent},{new("UICorner",{CornerRadius=UDim.new(0,radius)})})
            new("UIStroke",{Color=THEME.line,Thickness=1.4,Transparency=THEME.lineIdle,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=body})
            local function mouseButton(name,clipX,fillX)
                local clip=new("Frame",{Name=name.."Clip",BackgroundTransparency=1,ClipsDescendants=true,Position=UDim2.fromOffset(clipX,0),Size=UDim2.fromOffset(sideW,topPart),ZIndex=2,Parent=body})
                local fill=new("Frame",{Name=name,BackgroundColor3=THEME.pressFill,BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromOffset(fillX,0),Size=UDim2.fromOffset(sideW+radius,topPart+radius),Parent=clip},{new("UICorner",{CornerRadius=UDim.new(0,radius)})})
                return Cell.new(fill,nil,nil)
            end
            local left=mouseButton("LeftButton",0,0); local right=mouseButton("RightButton",width-sideW,-radius)
            new("Frame",{Name="Split",BackgroundColor3=THEME.line,BackgroundTransparency=.55,BorderSizePixel=0,Position=UDim2.fromOffset(0,topPart),Size=UDim2.new(1,0,0,1),ZIndex=4,Parent=body})
            local wheelW2=math.floor(topPart*.60)
            local wheel=new("Frame",{Name="Wheel",BackgroundColor3=THEME.keyFill,BackgroundTransparency=.1,BorderSizePixel=0,ClipsDescendants=true,Position=UDim2.fromOffset(math.floor((width-wheelW)/2),math.floor(topPart*.20)),Size=UDim2.fromOffset(wheelW,wheelW2),ZIndex=5,Parent=body},{new("UICorner",{CornerRadius=UDim.new(0,math.floor(wheelW/2))})})
            local wheelStroke=new("UIStroke",{Color=THEME.line,Thickness=1.2,Transparency=THEME.lineIdle,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=wheel})
            local wheelFill=new("Frame",{Name="Fill",BackgroundColor3=THEME.pressFill,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=6,Parent=wheel},{new("UICorner",{CornerRadius=UDim.new(0,math.floor(wheelW/2))})})
            local middle=Cell.new(wheelFill,wheelStroke,nil); middle.frame=wheel; middle.basePosition=wheel.Position
            local zone=math.min(math.floor(width/2)-7,math.floor((height-topPart)/2)-6)
            local ring=new("Frame",{Name="TrackZone",BackgroundTransparency=1,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(math.floor(width/2),topPart+math.floor((height-topPart)/2)),Size=UDim2.fromOffset(zone*2,zone*2),ZIndex=3,Parent=body},{new("UICorner",{CornerRadius=UDim.new(1,0)})})
            new("UIStroke",{Color=THEME.line,Thickness=1,Transparency=.8,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=ring})
            local dot=new("Frame",{Name="Pointer",BackgroundColor3=THEME.pressFill,BackgroundTransparency=.2,BorderSizePixel=0,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(8,8),ZIndex=4,Parent=ring},{new("UICorner",{CornerRadius=UDim.new(1,0)})})
            return left,right,middle,dot,zone-4
        end

        local mouseLeft,mouseRight,mouseWheel,trackerDot,trackerRadius=buildMouse(panel.body,keysWidth+CONFIG.mouseGap,math.floor((bodySize.Y-CONFIG.mouseHeight)/2),CONFIG.mouseWidth,CONFIG.mouseHeight)
        Buttons.Mouse1=mouseLeft; Buttons.Mouse2=mouseRight; Buttons.Mouse3=mouseWheel
        local pointerAccum=Vector2.zero; local pointerCurrent=Vector2.zero; local pointerLast=nil

        track(UserInputService.InputBegan:Connect(function(input)
            if CONFIG.hideWhileTyping and UserInputService:GetFocusedTextBox() then return end
            local kind = input.UserInputType
            local id = nil
            if kind == Enum.UserInputType.Keyboard then id = input.KeyCode.Name
            elseif kind == Enum.UserInputType.MouseButton1 then id = "Mouse1"
            elseif kind == Enum.UserInputType.MouseButton2 then id = "Mouse2"
            elseif kind == Enum.UserInputType.MouseButton3 then id = "Mouse3" end
            local cell = id and Buttons[id]
            if cell then cell:setActive(true) end
        end))

        track(UserInputService.InputEnded:Connect(function(input)
            local kind = input.UserInputType
            local id = nil
            if kind == Enum.UserInputType.Keyboard then id = input.KeyCode.Name
            elseif kind == Enum.UserInputType.MouseButton1 then id = "Mouse1"
            elseif kind == Enum.UserInputType.MouseButton2 then id = "Mouse2"
            elseif kind == Enum.UserInputType.MouseButton3 then id = "Mouse3" end
            local cell = id and Buttons[id]
            if cell then cell:setActive(false) end
        end))

        track(UserInputService.InputChanged:Connect(function(input)
            if CONFIG.hideWhileTyping and UserInputService:GetFocusedTextBox() then return end
            if input.UserInputType==Enum.UserInputType.MouseWheel then
                local up=input.Position.Z>0
                mouseWheel:flash(CONFIG.wheelFlash)
                local base=mouseWheel.basePosition
                mouseWheel.frame.Position=base+UDim2.fromOffset(0,up and -3 or 3)
                task.delay(CONFIG.wheelFlash,function() if mouseWheel.frame and mouseWheel.frame.Parent then tween(mouseWheel.frame,.08,{Position=base}) end end)
            elseif input.UserInputType==Enum.UserInputType.MouseMovement then
                local delta=Vector2.new(input.Delta.X,input.Delta.Y)
                if delta.Magnitude<.001 then
                    local position=Vector2.new(input.Position.X,input.Position.Y)
                    if pointerLast then delta=position-pointerLast end
                    pointerLast=position
                else pointerLast=nil end
                pointerAccum+=delta
            end
        end))

        track(RunService.RenderStepped:Connect(function(step)
            local frame=math.clamp(step,1/240,1/15)
            local velocity=pointerAccum/frame; pointerAccum=Vector2.zero
            local target=Vector2.zero; local speed=velocity.Magnitude
            if speed>1 then target=velocity.Unit*math.clamp(1-math.exp(-speed/CONFIG.trackSpeed),0,1) end
            local rate=target.Magnitude>pointerCurrent.Magnitude and CONFIG.trackAttack or CONFIG.trackRelease
            pointerCurrent+=(target-pointerCurrent)*math.clamp(rate*frame*60,0,1)
            if pointerCurrent.Magnitude<.004 then pointerCurrent=Vector2.zero end
            trackerDot.Position=UDim2.new(.5,pointerCurrent.X*trackerRadius,.5,pointerCurrent.Y*trackerRadius)
            trackerDot.BackgroundTransparency=.2-math.min(pointerCurrent.Magnitude,1)*.2
        end))

        track(UserInputService.InputBegan:Connect(function(input)
            if input.KeyCode ~= CONFIG.toggleKey then return end
            screen.Enabled = not screen.Enabled
        end))

        local function releaseAll()
            for _, cell in pairs(Buttons) do cell:setActive(false) end
            mouseWheel.frame.Position=mouseWheel.basePosition
            pointerAccum=Vector2.zero; pointerCurrent=Vector2.zero; pointerLast=nil
            trackerDot.Position=UDim2.fromScale(.5,.5)
        end

        local function destroy()
            for _, conn in ipairs(Connections) do pcall(function() conn:Disconnect() end) end
            table.clear(Connections)
            if screen then screen:Destroy() end
            ENV.__LiveKeyboardOverlay = nil
        end

        ENV.__LiveKeyboardOverlay = {destroy = destroy, screen = screen, panel = panel, config = CONFIG}

        getgenv().BladeNightVSSetKeybindsVisual = function(on)
            if on then screen.Enabled = true else screen.Enabled = false releaseAll() end
        end
    end

    -- [[ CONTROLLER VISUAL OVERLAY ]]
    do
        local Players = game:GetService("Players")
        local UserInputService = game:GetService("UserInputService")
        local TweenService = game:GetService("TweenService")
        local RunService = game:GetService("RunService")
        local LocalPlayer = Players.LocalPlayer
        while not LocalPlayer do task.wait() LocalPlayer = Players.LocalPlayer end

        local CONFIG = {
            guiName = "LiveControllerOverlay",
            uiScale = 1.5,
            toggleKey = Enum.KeyCode.F8,
            hideWhileTyping = true,
            stickDeadzone = 0.08,
            stickSmoothing = 0.55,
            triggerSmooth = 0.65,
            triggerDeadzone = 0.02,
            fadeIn = 0.03,
            fadeOut = 0.11,
            defaultPos = Vector2.new(0.025, 0.62),
        }

        local THEME = {
            panelFill = Color3.fromRGB(0, 0, 0), panelIdle = 0.45,
            keyFill = Color3.fromRGB(0, 0, 0), keyIdle = 0.28,
            pressFill = Color3.fromRGB(255, 255, 255), pressIdle = 0.04, stickPress = 0.72,
            line = Color3.fromRGB(255, 255, 255), lineIdle = 0.30, lineActive = 0.00,
            textIdle = Color3.fromRGB(245, 245, 245), textActive = Color3.fromRGB(10, 10, 10), textStroke = 0.55,
            headerIdle = 0.35, headerLocked = 1.00,
            font = Enum.Font.GothamBold, fontCaption = Enum.Font.Gotham,
        }

        local BODY_WIDTH = 296
        local BODY_HEIGHT = 146

        local LAYOUT = {
            {id="ButtonL2",label="L2",x=0,y=0,w=86,h=22,analog=true},
            {id="ButtonR2",label="R2",x=210,y=0,w=86,h=22,analog=true,fillFrom="right"},
            {id="ButtonL1",label="L1",x=0,y=26,w=86,h=20},
            {id="ButtonR1",label="R1",x=210,y=26,w=86,h=20},
            {id="DPadUp",label="↑",x=31,y=61,w=26,h=26},
            {id="DPadLeft",label="←",x=4,y=88,w=26,h=26},
            {id="DPadRight",label="→",x=58,y=88,w=26,h=26},
            {id="DPadDown",label="↓",x=31,y=115,w=26,h=26},
            {id="ButtonY",label="Y",x=239,y=61,w=26,h=26,circle=true},
            {id="ButtonX",label="X",x=212,y=88,w=26,h=26,circle=true},
            {id="ButtonB",label="B",x=266,y=88,w=26,h=26,circle=true},
            {id="ButtonA",label="A",x=239,y=115,w=26,h=26,circle=true},
            {id="ButtonSelect",label="SELECT",x=96,y=52,w=48,h=15},
            {id="ButtonStart",label="START",x=152,y=52,w=48,h=15},
        }

        local STICKS = {
            {id="Thumbstick1",click="ButtonL3",cx=120,cy=106,radius=24,caption="L3"},
            {id="Thumbstick2",click="ButtonR3",cx=176,cy=106,radius=24,caption="R3"},
        }
        local Connections = {}
        local function track(conn)
            table.insert(Connections,conn)
            return conn
        end
        local function new(class, props, children)
            local inst = Instance.new(class)
            for key, value in pairs(props or {}) do
                if key ~= "Parent" then inst[key] = value end
            end
            for _, child in ipairs(children or {}) do child.Parent = inst end
            if props and props.Parent then inst.Parent = props.Parent end
            return inst
        end

        local ENV = (typeof(getgenv) == "function" and getgenv()) or _G
        if type(ENV.__LiveControllerOverlay) == "table" and type(ENV.__LiveControllerOverlay.destroy) == "function" then
            pcall(ENV.__LiveControllerOverlay.destroy)
        end

        local function resolveParent()
            if typeof(gethui) == "function" then
                local ok, hidden = pcall(gethui)
                if ok and typeof(hidden) == "Instance" then return hidden end
            end
            local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
            if ok and typeof(coreGui) == "Instance" then return coreGui end
            return LocalPlayer:WaitForChild("PlayerGui")
        end

        local guiParent = resolveParent()
        local previous = guiParent:FindFirstChild(CONFIG.guiName)
        if previous then previous:Destroy() end

        local screen = new("ScreenGui", {
            Name = CONFIG.guiName, ResetOnSpawn = false, IgnoreGuiInset = true,
            DisplayOrder = 9999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = guiParent,
        })

        local Cell = {}
        Cell.__index = Cell
        function Cell.new(fill, stroke, label) return setmetatable({fill=fill, stroke=stroke, label=label, active=false}, Cell) end
        function Cell:setActive(on)
            if self.active == on then return end
            self.active = on
            local duration = on and CONFIG.fadeIn or CONFIG.fadeOut
            if self.fill and not self.analog then tween(self.fill, duration, {BackgroundTransparency = on and (self.pressTransparency or THEME.pressIdle) or 1}) end
            if self.stroke then tween(self.stroke, duration, {Transparency = on and THEME.lineActive or THEME.lineIdle}) end
            if self.label and not self.analog then tween(self.label, duration, {TextColor3 = on and THEME.textActive or THEME.textIdle, TextStrokeTransparency = on and 1 or THEME.textStroke}) end
            if self.dot then self.dot.BackgroundTransparency = on and 0 or 0.15 end
        end
        function Cell:setAnalog(value)
            if not self.fill then return end
            value = math.clamp(value, 0, 1)
            self.fill.Size = UDim2.fromScale(value, 1)
            self.fill.BackgroundTransparency = value > CONFIG.triggerDeadzone and THEME.pressIdle or 1
            if self.stroke then self.stroke.Transparency=value>CONFIG.triggerDeadzone and (THEME.lineIdle-value*(THEME.lineIdle-THEME.lineActive)) or THEME.lineIdle end
        end
        function Cell:setStick(x,y)
            if not self.dot then return end
            local vec=Vector2.new(x,y)
            if vec.Magnitude<CONFIG.stickDeadzone then vec=Vector2.zero elseif vec.Magnitude>1 then vec=vec.Unit end
            self.dot.Position=UDim2.new(.5,vec.X*self.stickRadius,.5,-vec.Y*self.stickRadius)
        end

        local function makeKey(parent, def)
            local corner = def.circle and UDim.new(1, 0) or UDim.new(0, 5)
            local frame = new("Frame", {Name = def.id or "Key", BackgroundColor3 = THEME.keyFill,
                BackgroundTransparency = THEME.keyIdle, BorderSizePixel = 0, ClipsDescendants = true,
                Position = UDim2.fromOffset(def.x, def.y), Size = UDim2.fromOffset(def.w, def.h), Parent = parent},
                {new("UICorner", {CornerRadius = corner})})
            local stroke = new("UIStroke", {Color = THEME.line, Thickness = 1.4, Transparency = THEME.lineIdle,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame})
            local fromRight = def.fillFrom == "right"
            local fill = new("Frame", {Name = "Fill", BackgroundColor3 = THEME.pressFill,
                BackgroundTransparency = 1, BorderSizePixel = 0,
                AnchorPoint = fromRight and Vector2.new(1, 0) or Vector2.new(0, 0),
                Position = fromRight and UDim2.fromScale(1, 0) or UDim2.fromScale(0, 0),
                Size = def.analog and UDim2.fromScale(0, 1) or UDim2.fromScale(1, 1), ZIndex = 2, Parent = frame},
                {new("UICorner", {CornerRadius = corner})})
            local label
            if def.label then
                label = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = THEME.font,
                    Text = def.label, TextColor3 = THEME.textIdle, TextScaled = true,
                    TextStrokeColor3 = Color3.new(0, 0, 0), TextStrokeTransparency = THEME.textStroke, ZIndex = 3, Parent = frame},
                    {new("UIPadding", {PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2)})})
            end
            local cell = Cell.new(fill, stroke, label)
            cell.frame = frame
            cell.analog = def.analog == true
            return cell
        end

        local function makeStick(parent, def)
            local size = def.radius * 2
            local ring = new("Frame", {Name = def.id, BackgroundColor3 = THEME.keyFill,
                BackgroundTransparency = THEME.keyIdle, BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(def.cx, def.cy),
                Size = UDim2.fromOffset(size, size), Parent = parent},
                {new("UICorner", {CornerRadius = UDim.new(1, 0)})})
            local stroke = new("UIStroke", {Color = THEME.line, Thickness = 1.4, Transparency = THEME.lineIdle,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ring})
            local glow = new("Frame", {Name = "Glow", BackgroundColor3 = THEME.pressFill,
                BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = ring},
                {new("UICorner", {CornerRadius = UDim.new(1, 0)})})
            new("Frame", {Name = "Center", BackgroundColor3 = THEME.line, BackgroundTransparency = 0.6,
                BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(3, 3), ZIndex = 3, Parent = ring},
                {new("UICorner", {CornerRadius = UDim.new(1, 0)})})
            local dot = new("Frame", {Name = "Dot", BackgroundColor3 = THEME.pressFill,
                BackgroundTransparency = 0.2, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(9, 9), ZIndex = 4, Parent = ring},
                {new("UICorner", {CornerRadius = UDim.new(1, 0)})})
            if def.caption then
                new("TextLabel", {Name = def.caption, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0),
                    Position = UDim2.fromOffset(def.cx, def.cy + def.radius + 2),
                    Size = UDim2.fromOffset(30, 10), Font = THEME.fontCaption, Text = def.caption,
                    TextSize = 9, TextColor3 = THEME.textIdle, TextTransparency = 0.35,
                    TextStrokeColor3 = Color3.new(0, 0, 0), TextStrokeTransparency = 0.6, ZIndex = 3, Parent = parent})
            end
            local cell = Cell.new(glow, stroke, nil)
            cell.frame = ring
            cell.dot = dot
            cell.stickRadius = def.radius - 7
            cell.pressTransparency = THEME.stickPress
            return cell
        end

        local HEADER_HEIGHT = 18
        local PADDING = 8
        local Panel = {}
        Panel.__index = Panel
        function Panel.create(title, bodySize, defaultPos)
            local self = setmetatable({}, Panel)
            self.locked = false
            self.root = new("Frame", {Name = "Panel", Active = false, BackgroundColor3 = THEME.panelFill,
                BackgroundTransparency = THEME.panelIdle, BorderSizePixel = 0,
                Size = UDim2.fromOffset(bodySize.X + PADDING * 2, bodySize.Y + PADDING * 2 + HEADER_HEIGHT),
                Position = UDim2.fromScale(defaultPos.X, defaultPos.Y), Parent = screen},
                {new("UIScale", {Scale = CONFIG.uiScale}), new("UICorner", {CornerRadius = UDim.new(0, 10)})})
            self.body = new("Frame", {Name = "Body", Active = false, BackgroundTransparency = 1,
                Position = UDim2.fromOffset(PADDING, HEADER_HEIGHT + PADDING),
                Size = UDim2.fromOffset(bodySize.X, bodySize.Y), Parent = self.root})
            return self
        end

        local bodySize = Vector2.new(BODY_WIDTH, BODY_HEIGHT)
        local panel = Panel.create("CONTROLLER | discord.gg/S8y9w24aFE", bodySize, CONFIG.defaultPos)

        local Buttons = {}
        local Sticks = {}
        local stickTarget={Thumbstick1=Vector2.zero,Thumbstick2=Vector2.zero}
        local stickCurrent={Thumbstick1=Vector2.zero,Thumbstick2=Vector2.zero}
        local triggerTarget={ButtonL2=0,ButtonR2=0}
        local triggerCurrent={ButtonL2=0,ButtonR2=0}
        local function releaseAll()
            for _,cell in pairs(Buttons) do cell:setActive(false) end
            for id in pairs(stickTarget) do
                stickTarget[id]=Vector2.zero; stickCurrent[id]=Vector2.zero
                Sticks[id]:setStick(0,0)
            end
            for id in pairs(triggerTarget) do
                triggerTarget[id]=0; triggerCurrent[id]=0; Buttons[id]:setAnalog(0)
            end
        end

        for _, def in ipairs(LAYOUT) do Buttons[def.id] = makeKey(panel.body, def) end
        for _, def in ipairs(STICKS) do
            local cell = makeStick(panel.body, def)
            Sticks[def.id] = cell
            Buttons[def.click] = cell
        end

        local GAMEPAD_TYPES = {}
        for _, item in ipairs(Enum.UserInputType:GetEnumItems()) do if item.Name:sub(1, 7) == "Gamepad" then GAMEPAD_TYPES[item] = true end end

        local function isTyping() return CONFIG.hideWhileTyping and UserInputService:GetFocusedTextBox() ~= nil end

        track(UserInputService.InputBegan:Connect(function(input)
            if isTyping() or not GAMEPAD_TYPES[input.UserInputType] then return end
            local cell = Buttons[input.KeyCode.Name]
            if cell and not cell.analog then cell:setActive(true) end
        end))

        track(UserInputService.InputEnded:Connect(function(input)
            if not GAMEPAD_TYPES[input.UserInputType] then return end
            local name = input.KeyCode.Name
            local cell = Buttons[name]
            if cell and not cell.analog then cell:setActive(false) end
            if triggerTarget[name] then triggerTarget[name] = 0 end
            if stickTarget[name] then stickTarget[name] = Vector2.zero end
        end))

        track(UserInputService.InputChanged:Connect(function(input)
            if not GAMEPAD_TYPES[input.UserInputType] then return end
            local name = input.KeyCode.Name
            if stickTarget[name] then stickTarget[name] = Vector2.new(input.Position.X, input.Position.Y)
            elseif triggerTarget[name] then triggerTarget[name] = math.clamp(input.Position.Z, 0, 1) end
        end))

        track(RunService.RenderStepped:Connect(function(step)
            local frame = math.clamp(step, 1 / 240, 1 / 15)
            local stickRate = math.clamp(CONFIG.stickSmoothing * frame * 60, 0, 1)
            local triggerRate = math.clamp(CONFIG.triggerSmooth * frame * 60, 0, 1)
            for id, cell in pairs(Sticks) do
                local current = stickCurrent[id] + (stickTarget[id] - stickCurrent[id]) * stickRate
                if current.Magnitude < 0.002 then current = Vector2.zero end
                stickCurrent[id] = current
                cell:setStick(current.X, current.Y)
            end
            for id, target in pairs(triggerTarget) do
                local current = triggerCurrent[id] + (target - triggerCurrent[id]) * triggerRate
                if current < 0.002 then current = 0 end
                triggerCurrent[id] = current
                Buttons[id]:setAnalog(current)
            end
        end))

        track(UserInputService.InputBegan:Connect(function(input)
            if input.KeyCode ~= CONFIG.toggleKey or isTyping() then return end
            screen.Enabled = not screen.Enabled
        end))

        local function destroy()
            for _, conn in ipairs(Connections) do pcall(function() conn:Disconnect() end) end
            table.clear(Connections)
            if screen then screen:Destroy() end
            ENV.__LiveControllerOverlay = nil
        end

        ENV.__LiveControllerOverlay = {destroy = destroy, screen = screen, panel = panel, config = CONFIG, buttons = Buttons, sticks = Sticks}

        getgenv().BladeNightVSSetControllerVisual = function(on)
            if on then screen.Enabled = true else screen.Enabled = false releaseAll() end
        end
    end

    getgenv().BladeNightVSSetLiveOverlayScale=function(value)
        local scale=math.clamp(tonumber(value) or 1,.6,2)
        local keyboard=getgenv().__LiveKeyboardOverlay
        local controller=getgenv().__LiveControllerOverlay
        if keyboard and keyboard.panel and keyboard.panel.root then
            local uiScale=keyboard.panel.root:FindFirstChildOfClass("UIScale")
            if uiScale then uiScale.Scale=scale end
            if keyboard.config then keyboard.config.uiScale=scale end
        end
        if controller and controller.panel and controller.panel.root then
            local uiScale=controller.panel.root:FindFirstChildOfClass("UIScale")
            if uiScale then uiScale.Scale=1.5*scale end
            if controller.config then controller.config.uiScale=1.5*scale end
