    local AIMBOT_SPEED = 58
    local LAGGER_AIMBOT_SPEED = 40
    local aimbotSpeedProxy, aimbotSpeedWeld
    local function cleanupAimbotSpeedProxy()
        if aimbotSpeedWeld then pcall(function() aimbotSpeedWeld:Destroy() end) end
        if aimbotSpeedProxy then pcall(function() aimbotSpeedProxy:Destroy() end) end
        aimbotSpeedProxy, aimbotSpeedWeld = nil, nil
