    local function nebula(method,...)
        local api=getgenv().BladeNightVSNebulaAPI
        if api and api[method] then pcall(api[method],...); return end
        local args=table.pack(...)
        task.spawn(function()
            for _=1,600 do
                local delayedApi=getgenv().BladeNightVSNebulaAPI
                if delayedApi and delayedApi[method] then pcall(delayedApi[method],table.unpack(args,1,args.n)); return end
                task.wait(.1)
            end
        end)
    end

